#!/usr/bin/env bash
# bd-gh-watch: push local bead changes to GitHub issues as they happen.
#
# Watches the beads database under .beads/ with inotifywait (Linux) or
# fswatch (macOS), falling back to polling, and pushes what changed:
#
#   fields       title, description, status, priority, type and labels, via
#                beads' native `bd github push <ids>`
#   assignee     the bead's assignee (a GitHub login) as the issue's assignee
#   comments     new bead comments as issue comments
#   relations    parent-child dependencies as sub-issues and blocks
#                dependencies as "blocked by" links, added and removed
#
# Usage:
#   bd-gh-watch [options]
#
# Options:
#   -C DIR            run in DIR (default: current directory)
#   --once            run a single sync pass and exit
#   --initial-push    on the first run (no saved state), push every bead
#                     instead of only changes made from now on
#   --poll SECONDS    safety-net / fallback poll interval (default 30)
#   --debounce SECS   quiet period that ends a burst of writes (default 1)
#   --backend NAME    inotify | fswatch | poll (default: auto-detect)
#   --dolt-sync SECS  also keep the beads Dolt remote in step: `bd dolt pull`
#                     every SECS seconds (brings in what the GitHub Action
#                     pulled) and `bd dolt push` after each GitHub push
#                     (publishes the new issue links). Default 0 (off).
#   --dry-run         show what would be pushed; do not push or save state
#   -h, --help        show this help
#
# GitHub settings come from bd itself: `bd config set github.repository
# owner/repo` (or GITHUB_REPOSITORY) and a token in GITHUB_TOKEN (falls back
# to `gh auth token` when gh is installed). GITHUB_API_URL overrides the API
# endpoint (GitHub Enterprise).
#
# Loop guards (see README "Sync loops"):
#   * only beads whose title, description, status, priority, type or labels
#     changed since the last push are pushed; bd's own writes after a push
#     (external_ref, updated_at) are ignored
#   * the filesystem events caused by the watcher's own bd calls are drained
#     and discarded after every pass
#   * bd skips the API write when GitHub already matches (push content hash
#     plus a field comparison), so beads that changed because a GitHub edit
#     was imported from the JSONL produce no write and no new issue event
#   * assignees, comments and relations are checked against GitHub before
#     writing, so ones that came from GitHub are recorded, not written back
#   * a lock file keeps two watchers on the same clone from racing

set -euo pipefail

BD=${BD:-bd}
POLL=30
DEBOUNCE=1
BACKEND=auto
ONCE=false
INITIAL_PUSH=false
DRY_RUN=false
DOLT_SYNC=0

log() { printf '%s bd-gh-watch: %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
die() { log "$*"; exit 1; }
usage() { sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//'; }

while [ $# -gt 0 ]; do
  case $1 in
    -C) cd "$2"; shift ;;
    --once) ONCE=true ;;
    --initial-push) INITIAL_PUSH=true ;;
    --poll) POLL=$2; shift ;;
    --debounce) DEBOUNCE=$2; shift ;;
    --backend) BACKEND=$2; shift ;;
    --dolt-sync) DOLT_SYNC=$2; shift ;;
    --dry-run) DRY_RUN=true ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; die "unknown option: $1" ;;
  esac
  shift
done

command -v jq >/dev/null || die "jq is required"
command -v "$BD" >/dev/null || die "bd is required (https://github.com/gastownhall/beads)"

# Find the .beads directory the same way bd does: walk up from here.
find_beads_dir() {
  local d=$PWD
  while [ "$d" != / ]; do
    [ -d "$d/.beads" ] && { printf '%s\n' "$d/.beads"; return; }
    d=$(dirname "$d")
  done
  return 1
}
BEADS_DIR=$(find_beads_dir) || die "no .beads directory found (run bd init first)"
ROOT=$(dirname "$BEADS_DIR")
cd "$ROOT"

if [ -z "${GITHUB_TOKEN:-}" ] && command -v gh >/dev/null; then
  GITHUB_TOKEN=$(gh auth token 2>/dev/null || true)
  export GITHUB_TOKEN
fi

# Per-clone state lives in the git dir so it is never committed.
if GIT_DIR=$(git rev-parse --absolute-git-dir 2>/dev/null); then
  STATE_DIR=$GIT_DIR/bd-gh-sync
else
  STATE_DIR=$BEADS_DIR/bd-gh-sync.local
fi
mkdir -p "$STATE_DIR"
STATE=$STATE_DIR/pushed.json
LOCK=$STATE_DIR/watch.lock
RESP=$STATE_DIR/response.json
API=${GITHUB_API_URL:-https://api.github.com}

exec 9>"$LOCK"
if command -v flock >/dev/null; then
  flock -n 9 || die "another bd-gh-watch is already running for $ROOT"
fi

save_json() {
  [ "$DRY_RUN" = true ] && return
  printf '%s\n' "$2" >"$1.tmp" && mv "$1.tmp" "$1"
}
save_state() { save_json "$STATE" "$1"; }

# Beads in the current export ($EXPORT), one JSON object per line.
beads() { jq -c 'select((._type // "issue") == "issue")' <<<"$EXPORT"; }

# {id: fingerprint} of the fields `bd github push` sends.
fingerprints() {
  beads | jq -cn '
    [inputs
     | {key: .id,
        value: ({title, description: (.description // ""), status, priority,
                 issue_type, labels: ((.labels // []) | sort)} | tojson)}]
    | from_entries'
}

# {id: "repos/OWNER/REPO/issues/N"} for every bead linked to a GitHub issue.
links() {
  beads | jq -cn '
    [inputs
     | {id, m: ((.external_ref // "") | capture("^https?://[^/]+/(?<r>[^/]+/[^/]+)/issues/(?<n>[0-9]+)$"))}
     | {key: .id, value: "repos/\(.m.r)/issues/\(.m.n)"}]
    | from_entries'
}

# gh_api METHOD PATH [JSON]: call the GitHub REST API. The body lands in
# $RESP and the status in HTTP_STATUS; fails unless the status is 2xx.
gh_api() {
  HTTP_STATUS=$(curl -sS -o "$RESP" -w '%{http_code}' -X "$1" \
    -H "Authorization: Bearer $GITHUB_TOKEN" -H "Accept: application/vnd.github+json" \
    ${3:+--data "$3"} "${API%/}/$2") || HTTP_STATUS=000
  [ "${HTTP_STATUS:0:1}" = 2 ]
}

# A 4xx other than rate limiting will fail the same way next time.
permanent_failure() { [ "${HTTP_STATUS:0:1}" = 4 ] && [ "$HTTP_STATUS" != 403 ] && [ "$HTTP_STATUS" != 429 ]; }

# Commit pending Dolt changes; a no-op when there are none.
commit_dolt() {
  local out
  if ! out=$("$BD" dolt commit -m "$1" 2>&1) && ! grep -qi 'nothing to commit' <<<"$out"; then
    printf '%s\n' "$out" >&2
    return 1
  fi
}

# Each push_* below returns 0 when it wrote to GitHub, 1 when there was
# nothing to do, 2 on failure. On the first run (no state file) each one
# records the current beads as its baseline instead of pushing them, unless
# --initial-push.

# Title, description, status, priority, type and labels, via bd itself.
push_fields() {
  local current previous changed ids out
  current=$(fingerprints)

  if [ ! -s "$STATE" ]; then
    if [ "$INITIAL_PUSH" != true ]; then
      log "first run: recording $(jq length <<<"$current") bead(s) as the baseline (use --initial-push to push them all)"
      save_state "$current"
      return 1
    fi
    previous='{}'
  else
    previous=$(cat "$STATE")
  fi

  changed=$(jq -cn --argjson cur "$current" --argjson old "$previous" \
    '[$cur | to_entries[] | select($old[.key] != .value) | .key]')
  if [ "$changed" = '[]' ]; then
    # Drop state for beads that no longer exist so it does not grow forever.
    save_state "$(jq -cn --argjson cur "$current" --argjson old "$previous" \
      '$old | with_entries(select($cur[.key] != null))')"
    return 1
  fi

  mapfile -t ids < <(jq -r '.[]' <<<"$changed")
  if [ "$DRY_RUN" = true ]; then
    log "would push ${#ids[@]} bead(s): ${ids[*]}"
    return 0
  fi

  log "pushing ${#ids[@]} bead(s): ${ids[*]}"
  if ! out=$("$BD" github push "${ids[@]}" 2>&1); then
    printf '%s\n' "$out" >&2
    log "push failed; will retry"
    return 2
  fi
  [ -n "$out" ] && printf '%s\n' "$out" >&2
  if grep -qiE 'failed to (create|update|push)' <<<"$out"; then
    log "push reported per-issue failures; will retry those beads"
    return 2
  fi

  # Record what was pushed, using the fingerprints read *before* the push:
  # a bead edited while the push ran still differs and goes out next pass.
  save_state "$(jq -cn --argjson cur "$current" --argjson old "$previous" --argjson ids "$changed" '
    ($old | with_entries(select($cur[.key] != null)))
    + ($cur | with_entries(select(.key as $k | $ids | index($k))))')"

  # bd github push records new issue links (external_ref) in the Dolt
  # working set without committing; commit so `bd dolt push` carries them.
  commit_dolt "bd-gh-watch: link GitHub issues" || log "could not commit issue links to Dolt"
  if [ "$DOLT_SYNC" -gt 0 ]; then
    if out=$("$BD" dolt push 2>&1); then
      log "pushed beads to the Dolt remote"
    else
      printf '%s\n' "$out" >&2
      log "bd dolt push failed; will retry after the next change"
    fi
  fi
  return 0
}

# A bead has one assignee; on GitHub it is the issue's first assignee (what
# `bd github pull` reads back), so a matching first assignee is in sync and
# extra GitHub assignees are kept. Otherwise the bead's assignee replaces them.
push_assignees() {
  local file=$STATE_DIR/assignees.json current previous id path want rc=1
  current=$(beads | jq -cn '[inputs | {key: .id, value: (.assignee // "")}] | from_entries')
  if [ ! -s "$file" ] && [ "$INITIAL_PUSH" != true ]; then
    save_json "$file" "$current"
    return 1
  fi
  previous=$(cat "$file" 2>/dev/null || echo '{}')
  while IFS=$'\t' read -r id path want; do
    [ -n "$id" ] || continue
    if [ "$DRY_RUN" = true ]; then
      log "would set the assignee of $id to '${want}'"
      rc=0
      continue
    fi
    if ! gh_api GET "$path"; then
      log "$id: could not read $path (HTTP $HTTP_STATUS); will retry"
      current=$(jq -c --arg id "$id" --argjson old "$previous" '.[$id] = $old[$id]' <<<"$current")
      rc=2
      continue
    fi
    [ "$(jq -r '.assignee.login // ""' "$RESP")" = "$want" ] && continue
    if gh_api PATCH "$path" "$(jq -cn --arg a "$want" '{assignees: (if $a == "" then [] else [$a] end)}')"; then
      log "$id: assignee set to '${want}' on GitHub"
      [ "$rc" = 1 ] && rc=0
    elif permanent_failure; then
      log "$id: GitHub refused assignee '${want}' (HTTP $HTTP_STATUS; is it a GitHub login?); not retrying"
    else
      log "$id: could not set the assignee (HTTP $HTTP_STATUS); will retry"
      current=$(jq -c --arg id "$id" --argjson old "$previous" '.[$id] = $old[$id]' <<<"$current")
      rc=2
    fi
  done < <(jq -rn --argjson cur "$current" --argjson old "$previous" --argjson links "$(links)" '
    $cur | to_entries[]
    | select(.value != ($old[.key] // "") and $links[.key])
    | [.key, $links[.key], .value] | @tsv')
  save_json "$file" "$current"
  return "$rc"
}

# New bead comments become GitHub comments, tagged with a hidden marker so
# the GitHub Action never imports them back. A comment whose text is already
# on the issue (it came from GitHub) is only recorded.
push_comments() {
  local file=$STATE_DIR/comments.json current done_ids id bead path text rc=1
  current=$(beads | jq -cn --argjson links "$(links)" '
    [inputs | .id as $b | (.comments // [])[]
     | {id, bead: $b, path: ($links[$b] // null), text}]')
  if [ ! -s "$file" ] && [ "$INITIAL_PUSH" != true ]; then
    save_json "$file" "$(jq -c 'map(.id)' <<<"$current")"
    return 1
  fi
  done_ids=$(cat "$file" 2>/dev/null || echo '[]')
  while IFS=$'\t' read -r id bead path; do
    [ -n "$id" ] || continue
    text=$(jq -r --arg id "$id" '.[] | select(.id == $id) | .text' <<<"$current")
    if [ "$DRY_RUN" = true ]; then
      log "would post comment $id of $bead"
      rc=0
      continue
    fi
    if ! gh_api GET "$path/comments?per_page=100"; then
      log "$bead: could not read comments (HTTP $HTTP_STATUS); will retry"
      rc=2
      continue
    fi
    if jq -e --arg id "$id" --arg text "$text" '
        def norm: gsub("\r\n"; "\n") | sub("^\\s+"; "") | sub("\\s+$"; "");
        any(.[]; (.body | contains("<!-- bd-comment:\($id) -->")) or ((.body | norm) == ($text | norm)))' \
        "$RESP" >/dev/null; then
      :
    elif gh_api POST "$path/comments" "$(jq -cn --arg id "$id" --arg text "$text" \
        '{body: "\($text)\n\n<!-- bd-comment:\($id) -->"}')"; then
      log "$bead: posted a comment"
      [ "$rc" = 1 ] && rc=0
    elif permanent_failure; then
      log "$bead: GitHub refused a comment (HTTP $HTTP_STATUS); not retrying"
    else
      log "$bead: could not post a comment (HTTP $HTTP_STATUS); will retry"
      rc=2
      continue
    fi
    done_ids=$(jq -c --arg id "$id" '. + [$id]' <<<"$done_ids")
  done < <(jq -r --argjson handled "$done_ids" '
    .[] | select(.path and (.id | IN($handled[])) == false) | [.id, .bead, .path] | @tsv' <<<"$current")
  # Forget comments that no longer exist.
  save_json "$file" "$(jq -c --argjson cur "$current" '[.[] | select(IN($cur[].id))]' <<<"$done_ids")"
  return "$rc"
}

# relation_op add|remove TYPE FROM_PATH TO_PATH: make GitHub match one bead
# dependency. FROM depends on TO: for parent-child, FROM is the sub-issue.
relation_op() {
  local op=$1 type=$2 from=$3 to=$4 list item id present
  case $type in
    parent-child) list="$to/sub_issues?per_page=100"; item=$from ;;
    blocks) list="$from/dependencies/blocked_by?per_page=100"; item=$to ;;
  esac
  # the relation endpoints take the issue's numeric id, not its number
  gh_api GET "$item" || return 1
  id=$(jq -r .id "$RESP")
  gh_api GET "$list" || return 1
  present=$(jq --argjson id "$id" 'any(.[]; .id == $id)' "$RESP")
  case $op:$type:$present in
    add:*:true|remove:*:false) return 0 ;;
    add:parent-child:*) gh_api POST "$to/sub_issues" "{\"sub_issue_id\": $id}" ;;
    add:blocks:*) gh_api POST "$from/dependencies/blocked_by" "{\"issue_id\": $id}" ;;
    remove:parent-child:*) gh_api DELETE "$to/sub_issue" "{\"sub_issue_id\": $id}" ;;
    remove:blocks:*) gh_api DELETE "$from/dependencies/blocked_by/$id" ;;
  esac
}

# Bead dependencies become GitHub sub-issues (parent-child) and "blocked by"
# links (blocks); removing the dependency removes the link.
push_relations() {
  local file=$STATE_DIR/relations.json links current synced plan op from type to rc=1
  links=$(links)
  current=$(beads | jq -cn '
    [inputs | (.dependencies // [])[]
     | select(.type == "blocks" or .type == "parent-child")
     | "\(.issue_id) \(.type) \(.depends_on_id)"] | unique')
  if [ ! -s "$file" ] && [ "$INITIAL_PUSH" != true ]; then
    save_json "$file" "$current"
    return 1
  fi
  synced=$(cat "$file" 2>/dev/null || echo '[]')
  # Links whose beads are not on GitHub yet wait; removals of such links
  # need no GitHub call.
  plan=$(jq -rn --argjson cur "$current" --argjson old "$synced" --argjson links "$links" '
    def linked: split(" ") | ($links[.[0]] and $links[.[2]]);
    (($cur - $old)[] | select(linked) | "add \(.)"),
    (($old - $cur)[] | if linked then "remove \(.)" else "forget \(.)" end)')
  while read -r op from type to; do
    [ -n "$op" ] || continue
    if [ "$op" != forget ]; then
      if [ "$DRY_RUN" = true ]; then
        log "would $op $from $type $to on GitHub"
        rc=0
        continue
      fi
      if relation_op "$op" "$type" "$(jq -r --arg b "$from" '.[$b]' <<<"$links")" \
          "$(jq -r --arg b "$to" '.[$b]' <<<"$links")"; then
        log "$from $type $to: ${op%e}ed on GitHub"
        [ "$rc" = 1 ] && rc=0
      elif permanent_failure; then
        log "$from $type $to: GitHub refused to $op it (HTTP $HTTP_STATUS); not retrying"
      else
        log "$from $type $to: could not $op it on GitHub (HTTP $HTTP_STATUS); will retry"
        rc=2
        continue
      fi
    fi
    case $op in
      add) synced=$(jq -c --arg e "$from $type $to" '. + [$e] | unique' <<<"$synced") ;;
      *) synced=$(jq -c --arg e "$from $type $to" '. - [$e]' <<<"$synced") ;;
    esac
  done <<<"$plan"
  save_json "$file" "$synced"
  return "$rc"
}

# One pass: push whatever changed since the last pass.
sync_pass() {
  local rc=1 r step
  if ! EXPORT=$("$BD" export); then
    log "bd export failed; will retry"
    return 2
  fi
  for step in push_fields push_assignees push_comments push_relations; do
    r=0
    "$step" || r=$?
    if [ "$r" = 2 ] || [ "$rc" = 2 ]; then rc=2; elif [ "$r" = 0 ]; then rc=0; fi
    # Pushing creates issues and links them; the later steps need the links.
    if [ "$step" = push_fields ] && [ "$r" = 0 ] && [ "$DRY_RUN" != true ]; then
      EXPORT=$("$BD" export) || return 2
    fi
  done
  return "$rc"
}

run_pass() {
  local rc=0
  sync_pass || rc=$?
  # Something was pushed: look once more right away for edits that landed
  # while the push was running.
  if [ "$rc" -eq 0 ] && [ "$DRY_RUN" != true ]; then
    sync_pass || true
  fi
}

if [ "$ONCE" = true ]; then
  rc=0
  sync_pass || rc=$?
  [ "$rc" -eq 2 ] && exit 1
  exit 0
fi

if [ "$BACKEND" = auto ]; then
  if command -v inotifywait >/dev/null; then BACKEND=inotify
  elif command -v fswatch >/dev/null; then BACKEND=fswatch
  else BACKEND=poll
  fi
fi

# Paths whose changes are not bead writes: our state, exports, logs, locks.
IGNORE='(\.jsonl|\.log|\.lock|\.pid|\.port|/last-touched|/bd\.sock.*|\.activity)$'

watch_events() {
  case $BACKEND in
    inotify)
      exec inotifywait -m -r -q -e close_write,moved_to,create,delete \
        --exclude "$IGNORE" --format '%w%f' "$BEADS_DIR" ;;
    fswatch)
      exec fswatch -r -e "$IGNORE" "$BEADS_DIR" ;;
    poll)
      # No event source: the main loop's poll timeout does all the work.
      exec tail -f /dev/null ;;
    *) die "unknown backend: $BACKEND" ;;
  esac
}

if [ "$DOLT_SYNC" -gt 0 ] && [ "$DOLT_SYNC" -lt "$POLL" ]; then
  POLL=$DOLT_SYNC
fi
LAST_DOLT_PULL=$SECONDS

dolt_pull() {
  [ "$DOLT_SYNC" -gt 0 ] && [ $((SECONDS - LAST_DOLT_PULL)) -ge "$DOLT_SYNC" ] || return 0
  LAST_DOLT_PULL=$SECONDS
  local out
  # Commit first so a pending working set never blocks the merge.
  commit_dolt "bd-gh-watch: local changes" || true
  out=$("$BD" dolt pull 2>&1) || { printf '%s\n' "$out" >&2; log "bd dolt pull failed"; }
}

log "watching $BEADS_DIR (backend: $BACKEND, poll: ${POLL}s, dolt sync: ${DOLT_SYNC}s)"
WATCH_PID=
trap '[ -n "$WATCH_PID" ] && kill "$WATCH_PID" 2>/dev/null' EXIT
trap 'exit 0' INT TERM

# The event source must not inherit the lock (fd 9), or it outlives us holding it.
start_watch() { exec 3< <(watch_events 9>&-); WATCH_PID=$!; }

# Drain queued events until the stream has been quiet for $1 seconds (capped
# at 10s so a constantly busy database cannot starve the watcher). Our own
# bd invocations touch the Dolt files even when they only read, so whatever
# arrives right after a pass is ours; a user edit swallowed here is picked up
# by the next poll.
drain() {
  local deadline=$((SECONDS + 10))
  while [ "$SECONDS" -lt "$deadline" ] && read -r -t "$1" _ <&3; do :; done
}

start_watch
run_pass
drain 0.5
while true; do
  if read -r -t "$POLL" _ <&3; then
    drain "$DEBOUNCE"       # wait until the burst of writes settles
  else
    rc=$?
    # >128 is a timeout (the safety-net poll); anything else means the
    # event source died, so fall back to polling.
    if [ "$rc" -le 128 ] && [ "$BACKEND" != poll ]; then
      log "file watcher exited; falling back to polling every ${POLL}s"
      BACKEND=poll
      start_watch
    fi
  fi
  dolt_pull
  run_pass
  drain 0.5
done
