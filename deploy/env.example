# /etc/bd-gh-sync/env (chown root:bd-gh-sync, chmod 0640)

# Fine-grained PAT with access to every synced repository:
#   Contents: read and write (Dolt data / JSONL export)
#   Issues: read and write
#   Webhooks: read and write (only for `server add`)
GITHUB_TOKEN=github_pat_...

# Shared secret GitHub signs webhooks with; at least 16 characters.
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=...
