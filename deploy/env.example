# /etc/bd-gh-sync/env (chown root:bd-gh-sync, chmod 0640)

# Fine-grained PAT with access to every synced repository:
#   Contents: read and write (reads and pushes refs/dolt/data, or the JSONL export)
#   Issues: read and write
#   Webhooks: read and write (only for `server add`)
GITHUB_TOKEN=github_pat_...

# Optional fine-grained PAT or GitHub App token with Projects read/write access.
# Required only when project_sync entries are configured.
GITHUB_PROJECTS_TOKEN=github_pat_...

# Fallback secret for repositories without their own; `server add` gives each
# repository its own secret (in <data_dir>/.secrets) and registers it with the
# webhook. At least 16 characters.
# Generate one with: openssl rand -hex 32
WEBHOOK_SECRET=...
