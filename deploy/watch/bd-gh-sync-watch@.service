[Unit]
Description=bd-gh-sync watch (beads -> GitHub) for /%I
After=network-online.target

[Service]
WorkingDirectory=/%I
EnvironmentFile=-%h/.config/bd-gh-sync/env
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/bd-gh-sync watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
