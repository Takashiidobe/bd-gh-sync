#!/usr/bin/env bash
# Minimal `gh` stand-in for the tests: `gh api [--paginate] PATH [--jq FILTER]`
# against $GITHUB_API_URL (the fake GitHub server).
set -euo pipefail
[ "${1:-}" = api ] || { echo "stub gh: only 'gh api' is supported" >&2; exit 1; }
shift
path=''
filter=.
while [ $# -gt 0 ]; do
  case $1 in
    --paginate) ;;
    --jq) filter=$2; shift ;;
    *) path=$1 ;;
  esac
  shift
done
curl -fsS "$GITHUB_API_URL/${path#/}" | jq -r "$filter"
